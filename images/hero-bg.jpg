<svg width="1920" height="1080" viewBox="0 0 1920 1080" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#5b0f4f;stop-opacity:1" />
      <stop offset="25%" style="stop-color:#3f2fbb;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#740707;stop-opacity:1" />
      <stop offset="75%" style="stop-color:#dd5217;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fcff74;stop-opacity:1" />
    </linearGradient>
    <filter id="blur">
      <feGaussianBlur in="SourceGraphic" stdDeviation="3" />
    </filter>
  </defs>
  <rect width="1920" height="1080" fill="url(#grad1)" />
  <circle cx="200" cy="200" r="150" fill="#ffffff" opacity="0.1" filter="url(#blur)" />
  <circle cx="1700" cy="800" r="200" fill="#ffffff" opacity="0.1" filter="url(#blur)" />
  <circle cx="1000" cy="500" r="100" fill="#ffffff" opacity="0.05" filter="url(#blur)" />
  <text x="960" y="540" font-family="Arial, sans-serif" font-size="72" font-weight="bold" text-anchor="middle" fill="#ffffff">
    مؤسسة إبداع العرب
  </text>
  <text x="960" y="620" font-family="Arial, sans-serif" font-size="36" text-anchor="middle" fill="#ffffff" opacity="0.9">
    للتصوير الفوتوغرافي والإبداع
  </text>
</svg>
