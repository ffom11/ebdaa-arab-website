<!-- Design Portfolio 2 -->
<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="design2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#43e97b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#38f9d7;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="300" fill="url(#design2)"/>
  <text x="200" y="140" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle">مينيو مطعم</text>
  <text x="200" y="170" font-family="Arial, sans-serif" font-size="16" fill="white" text-anchor="middle">تصميم احترافي</text>
  <rect x="120" y="190" width="160" height="80" fill="white" opacity="0.2" rx="5"/>
  <line x1="130" y1="210" x2="270" y2="210" stroke="white" stroke-width="1"/>
  <line x1="130" y1="230" x2="270" y2="230" stroke="white" stroke-width="1"/>
  <line x1="130" y1="250" x2="270" y2="250" stroke="white" stroke-width="1"/>
